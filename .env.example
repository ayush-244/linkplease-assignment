# .env.example — copy this to .env and fill in your real values.
# Never commit .env to version control.

# PostgreSQL connection string.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/linkplease

# Your PseudoGram API key.
# Used both for the X-Api-Key header on outgoing requests
# AND as the HMAC-SHA256 secret when verifying incoming webhook signatures.
PSEUDOGRAM_API_KEY=your_api_key_here

# PseudoGram base URL.  Only override this if you're pointing at a local mock.
# Default value is used if not set.
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# Optional tuning (rarely need to change these):
# WORKER_POLL_INTERVAL=1.0
# DM_RECONCILE_INTERVAL=2.0
